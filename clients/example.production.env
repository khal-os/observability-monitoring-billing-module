# ============================================================================
# PRODUCTION ENV CONTRACT for one single-tenant client deployment
# (compose role files: compose.module.yml + compose.connector.yml +
# compose.mongodb.yml). This file is the FULL contract; the workstation/demo
# shape lives in example.development.env.
#
# This file is the ONLY thing that knows the client. To deploy N clients,
# create N copies (real ones are gitignored — they hold secrets and are the
# stack's operational identity) and apply the same compose chain with each:
#
#   docker compose -f compose.module.yml -f compose.connector.yml \
#     -f compose.mongodb.yml --env-file clients/<name>.env up -d
#
# Values below are EMPTY on purpose (production is operator-supplied, never
# defaulted); every optional block ships commented with its default noted.
# ============================================================================

# ── REQUIRED ────────────────────────────────────────────────────────────────

# Identity: compose project (container/volume/network prefix) and the
# client's database name. Keep both equal to the client slug.
COMPOSE_PROJECT_NAME=
CLIENT_NAME=

# Decision 130: the client's business timezone, IANA name. One knob: the
# invoice's month boundary AND every displayed timestamp cut at THIS zone's
# midnight — so the screen always agrees with the bill. Forward-only: never
# change it after a month has closed.
CLIENT_TIMEZONE=

# The BROWSER-visible URL of THIS client's LangWatch — in production, the
# reverse-proxy URL (e.g. https://langwatch.<host>, see deploy/RUNBOOK-VM.md;
# the proxy must be up before onboarding). All three of LangWatch's own URLs
# are set from this one value and session auth validates against it — a
# mismatch fails login. Compose refuses to start without it (no fallback).
LANGWATCH_PUBLIC_URL=

# Per-instance LangWatch secrets — generate each with `openssl rand -base64 32`.
# Compose refuses to start (or stop) the connector role while any is empty.
# CREDENTIALS_SECRET must NEVER change after first boot (stored credentials
# become undecryptable).
LW_NEXTAUTH_SECRET=
LW_API_TOKEN_JWT_SECRET=
LW_CREDENTIALS_SECRET=

# Mongo root credentials for this client's OWN mongo (created on first boot,
# enforced from then on; set BEFORE first boot — the volume keeps the
# first-boot user). Production always sets both.
MONGO_DB_USER=
MONGO_DB_PASSWORD=

# Image references, pinned to registry tags in production (e.g.
# <registry>/platform-module:1.4.2) — rollback = repoint the tag. Empty
# falls back to the locally-built :local images (build-on-box deploys).
MODULE_IMAGE=
CONNECTOR_IMAGE=
# UI_IMAGE=

# LangWatch project id (project_..., visible in the LangWatch UI URL) —
# written by scripts/3-onboard-langwatch.sh. BOTH the row filter of the
# direct-ClickHouse sync AND the ingestion gate (decision 127): while empty,
# the trace-ingestion-worker idles and `make sync` refuses to run.
LANGWATCH_PROJECT_ID=

# ── khal platform auth (STRONGLY recommended in production) ────────────────
# The khal-wide quartet (ADR-97/decision 132): discovery + tenant resolve the
# Auth System at runtime from /.well-known/registers; the credential is this
# module's own (introspection is protected — absent credential = every
# request 401, fail closed). Unset = /api/v1 OPEN (PoC behavior) — never
# expose an open API beyond loopback. URLs are resolved FROM INSIDE the api
# container (127.0.0.1 there is the container itself). Prove it took effect:
# ./scripts/5-verify-client.sh <name> asserts tokenless requests answer 401.
KHAL_DISCOVERY_URL=
KHAL_TENANT=
KHAL_CLIENT_ID=
KHAL_CLIENT_SECRET=
# DEPRECATED spellings (pre-discovery, still honored — AUTH_SYSTEM_URL is
# ignored when KHAL_DISCOVERY_URL is set):
# AUTH_SYSTEM_URL=
# AUTH_SYSTEM_CLIENT_ID=
# AUTH_SYSTEM_CLIENT_SECRET=

# ── Exposure (loopback by default) ─────────────────────────────────────────

# Host ports. On a dedicated host per client OMIT all three — the compose
# defaults apply (API_PORT=3000, LANGWATCH_PORT=5560, UI_PORT=8080) and the
# deploy scripts print/probe well-formed URLs. On a shared host give every
# client unique ones.
# API_PORT=3000
# LANGWATCH_PORT=5560
# UI_PORT=8080

# Host bind address per published port — default LOOPBACK (127.0.0.1):
# nothing is reachable from other machines until you opt in. Exposing needs
# BOTH *_BIND=0.0.0.0 AND a firewall in front. The UI is the client-facing
# surface, so UI_BIND is the one that may legitimately be needed — it
# proxies the API same-origin, keeping the API port itself loopback.
# API_BIND=127.0.0.1
# LANGWATCH_BIND=127.0.0.1
# UI_BIND=127.0.0.1

# Optional, print-only: the public URL of the client UI. Deploy summaries
# (5-verify-client.sh) print it instead of the localhost form.
# MODULE_PUBLIC_URL=

# Cross-origin browser access to the API (audit D-1) — opt-in and EXACT:
# comma-separated origins echoed back individually (never a wildcard; the
# archive is unmasked LLM content). Unset = same-origin only (the shipped
# design: the UI proxies /api on its own origin).
# CORS_ALLOWED_ORIGINS=

# ── Data stores (optional overrides) ───────────────────────────────────────

# Mongo container memory limit (default 512m). Mongo sizes its cache from
# this — keep it ≥ the working set (decision 77: at 1M traces ≈ 3.4 GB of
# data, 4g keeps every query path in memory).
# MONGO_MEMORY_LIMIT=512m

# EXTERNAL database (decision 65): to use a managed/external MongoDB, drop
# compose.mongodb.yml from the compose chain and set host/port (+ the
# credentials above). MUST be a replica set (decision 81 — multi-document
# transactions); Atlas and managed offerings always are.
# MONGO_DB_HOST=mongo
# MONGO_DB_PORT=27017
#
# MongoDB ATLAS specifically: set the four lines below (PORT is ignored —
# SRV picks the ports; value must be exactly `true`; the Makefile then drops
# compose.mongodb.yml automatically). Atlas Network Access must allowlist
# this docker host's PUBLIC IP. NOTE: `make backup` assumes the in-project
# mongo — with Atlas use Atlas's own backup/export tooling.
# MONGO_DB_ATLAS=true
# MONGO_DB_HOST=cluster0.xxxxx.mongodb.net
# MONGO_DB_USER=
# MONGO_DB_PASSWORD=

# Database name inside mongo/Atlas. Default = the client slug (CLIENT_NAME)
# — the single-tenant identity convention. Override only with reason.
# MONGO_DB_NAME=

# ── Sync worker (production keeps the defaults — shown) ────────────────────
# Seconds between "anything new?" polls of the source once caught up.
# TRACE_INGESTION_INTERVAL_SECONDS=60
# Max traces fetched/processed per sync tick — the worker's memory/work bound.
# TRACE_INGESTION_BATCH_SIZE=1000
# Seconds a trace must stay UNCHANGED before ingestion (decision 61): ingest
# mid-run = partial spans/tokens priced forever (the stamp is immutable).
# TRACE_INGESTION_QUIET_PERIOD_SECONDS=900
# Backstop cadence for re-stamping pending_price traces — price registration
# (POST /prices, make price) already reprocesses immediately (decision 57).
# REPROCESS_INTERVAL_SECONDS=3600

# ── Month auto-close (decision 131) — explicit OPT-IN, off by default ──────
# Without the COMPOSE_PROFILES line the billing-close-scheduler service does
# not exist and closing stays runbook-only (make billing-close). Enabled, the
# scheduler closes each fully-past month at the client's midnight + the delay
# below, oldest first, through the SAME use case as the runbook (trigger
# 'scheduled' in the audit). pending_price blocks and retries each cycle (QA5:
# the bill WAITS); a REOPENED month never auto-recloses. To disable later:
# comment the line and `make up` (then `up --remove-orphans` cleans the
# orphan container).
# COMPOSE_PROFILES=billing-auto-close
# BILLING_AUTO_CLOSE_DELAY_MINUTES=60
# BILLING_AUTO_CLOSE_CHECK_INTERVAL_SECONDS=900

# ── LangWatch scaling (decision 78) ────────────────────────────────────────
# The scaling unit is langwatch-workers (stateless queue consumers over the
# single postgres/redis/clickhouse spine); app and trace-ingestion-worker
# stay at 1 replica by design. Raising replicas multiplies load on the same
# three stores — raise their limits too, and budget host RAM (each workers
# replica is also capped at LANGWATCH_WORKERS_MEMORY_LIMIT).
# LANGWATCH_WORKERS_REPLICAS=1
# LANGWATCH_MEMORY_LIMIT=2g
# LANGWATCH_WORKERS_MEMORY_LIMIT=1536m
# LW_POSTGRES_MEMORY_LIMIT=256m
# LW_REDIS_MEMORY_LIMIT=512m
# LW_CLICKHOUSE_MEMORY_LIMIT=2g
# LW_CLICKHOUSE_CPU_LIMIT=1.0

# NOTE there is deliberately NO LANGWATCH_API_KEY here (decision 127): the
# key is the AGENTS' credential for SENDING traces in — no container of this
# component reads it. It lives in LangWatch's own Postgres; agents receive
# it via the platform vault (copy it from the LangWatch UI when seeding).
