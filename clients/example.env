# ============================================================================
# ENV CONTRACT for one single-tenant client deployment (compose role files:
# compose.module.yml + compose.langwatch.yml + compose.mongodb.yml).
#
# This file is the ONLY thing that knows the client. To deploy N clients,
# create N copies of this file (real ones are gitignored) and apply the same
# compose file with each:
#
#   docker compose -f compose.module.yml -f compose.langwatch.yml -f compose.mongodb.yml --env-file clients/<name>.env up -d
#
# A future deploy script just fills these values and runs that command.
# ============================================================================

# Identity: compose project (container/volume/network prefix) and the
# client's database name. Keep both equal to the client slug.
COMPOSE_PROJECT_NAME=example
CLIENT_NAME=example

# Host ports. On a shared host every client needs unique ones; on a
# dedicated host per client the defaults (3000/5560) are fine — omit both.
API_PORT=3001
LANGWATCH_PORT=5561
UI_PORT=8081

# Mongo root credentials for this client's OWN mongo (created on first
# boot, enforced from then on). Leave both empty for an auth-less dev DB.
# The volume keeps the first-boot user: changing this later requires
# recreating the mongo volume (or managing users via mongosh).
MONGO_DB_USER=
MONGO_DB_PASSWORD=

# Optional: EXTERNAL database (decision 65). Defaults point at the
# in-project mongo from compose.mongodb.yml; to use a managed/external
# MongoDB instead, drop compose.mongodb.yml from the compose file chain
# and set host/port (+ credentials above) here.
# MONGO_DB_HOST=mongo
# MONGO_DB_PORT=27017

# Filled AFTER onboarding this client's LangWatch (signup -> org ->
# project -> API key at http://localhost:${LANGWATCH_PORT}). While empty,
# the sync uses the fixture-backed fake client instead of the real one,
# AND the sync-worker sidecar idles (continuous ingestion starts with
# onboarding).
LANGWATCH_API_KEY=

# Optional: LangWatch project id (e.g. project_abc123..., visible in the
# LangWatch UI URL). Filters the direct-ClickHouse sync to this project's
# rows — only needed if the instance ever hosts more than one project.
LANGWATCH_PROJECT_ID=

# Sync-worker knobs (all optional — defaults shown). interval: seconds
# between catch-up cycles once caught up · batch size: rows per batch (the
# worker's memory bound) · quiet period: seconds a trace must stay
# unchanged before it is ingested (decision 61 — the price stamp is
# immutable, so partial traces must settle first) · reprocess interval:
# backstop cadence for re-stamping pending_price traces.
# SYNC_INTERVAL_SECONDS=60
# SYNC_BATCH_SIZE=1000
# SYNC_QUIET_PERIOD_SECONDS=900
# REPROCESS_INTERVAL_SECONDS=3600

# Per-instance LangWatch secrets — generate each with `openssl rand -base64 32`.
# CREDENTIALS_SECRET must NEVER change after first boot (stored credentials
# become undecryptable).
LW_NEXTAUTH_SECRET=
LW_API_TOKEN_JWT_SECRET=
LW_CREDENTIALS_SECRET=

# Image references (api also runs the sync-worker sidecar). Production
# deployments pin registry tags (e.g. registry.example.com/platform-api:1.4.2);
# dev builds locally via compose.dev.yml and keeps the defaults.
API_IMAGE=platform-api:local
# UI_IMAGE=platform-ui:local

# Dev-only (compose.dev.yml): publish mongo on this localhost port for
# Compass/mongosh. Leave unset in production env files.
# MONGO_HOST_PORT=27018
