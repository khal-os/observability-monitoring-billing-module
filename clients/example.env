# ============================================================================
# ENV CONTRACT for one single-tenant client deployment (compose role files:
# compose.module.yml + compose.connector.yml + compose.mongodb.yml).
#
# This file is the ONLY thing that knows the client. To deploy N clients,
# create N copies of this file (real ones are gitignored) and apply the same
# compose file with each:
#
#   docker compose -f compose.module.yml -f compose.connector.yml -f compose.mongodb.yml --env-file clients/<name>.env up -d
#
# A future deploy script just fills these values and runs that command.
# ============================================================================

# Identity: compose project (container/volume/network prefix) and the
# client's database name. Keep both equal to the client slug.
COMPOSE_PROJECT_NAME=example
CLIENT_NAME=example

# Host ports. On a shared host every client needs unique ones; on a
# dedicated host per client the compose defaults are fine — omit all three
# (API_PORT=3000, LANGWATCH_PORT=5560, UI_PORT=8080). The deploy scripts
# apply exactly these defaults when the var is absent (deploy-lib.sh
# host_port), so the URLs they print and probe stay well-formed.
API_PORT=3001
LANGWATCH_PORT=5561
UI_PORT=8081

# Host bind address per published port — the default is LOOPBACK
# (127.0.0.1): nothing is reachable from other machines until you opt in.
# Exposing a service beyond localhost requires BOTH setting its
# *_BIND=0.0.0.0 AND a firewall in front: the API is auth-less unless
# AUTH_SYSTEM_URL is set (full unmasked trace content), and LangWatch
# signup is open (NEXTAUTH_PROVIDER=email). The UI is the client-facing
# surface, so UI_BIND=0.0.0.0 is the one that may legitimately be needed
# — it proxies the API same-origin, keeping the API port itself loopback.
# API_BIND=127.0.0.1
# LANGWATCH_BIND=127.0.0.1
# UI_BIND=127.0.0.1

# Auth System (M2M) base URL — optional. Set it to require a Bearer token on
# every /api/v1 request (validated by introspection: authenticated-or-not
# only). Unset → API open (PoC behavior). Introspection is a protected
# endpoint, so the module needs its OWN M2M credential (provisioned in the
# Auth System) — without it every request answers 401 (fail closed).
# The URL is resolved FROM INSIDE the api container: 127.0.0.1 there is the
# container itself — use a host the container can reach (compose-network DNS
# name, LAN IP, or host-gateway). After enabling, prove it took effect:
# ./scripts/5-verify-client.sh <name> asserts tokenless requests answer 401.
# AUTH_SYSTEM_URL=
# AUTH_SYSTEM_CLIENT_ID=
# AUTH_SYSTEM_CLIENT_SECRET=

# Cross-origin browser access to the API (audit D-1) — opt-in and EXACT:
# comma-separated origins echoed back individually (never a wildcard; the
# archive is unmasked LLM content). Unset = same-origin only, which is the
# shipped design: the UI proxies /api on its own origin.
# CORS_ALLOWED_ORIGINS=

# Mongo root credentials for this client's OWN mongo (created on first
# boot, enforced from then on). Leave both empty for an auth-less dev DB.
# The volume keeps the first-boot user: changing this later requires
# recreating the mongo volume (or managing users via mongosh).
MONGO_DB_USER=
MONGO_DB_PASSWORD=

# Optional: mongo container memory limit (default 512m). Mongo sizes its
# cache from this — keep it ≥ the working set (decision 77: at 1M traces
# ≈ 3.4 GB of data, 4g keeps every query path in memory).
# MONGO_MEMORY_LIMIT=512m

# Optional: EXTERNAL database (decision 65). Defaults point at the
# in-project mongo from compose.mongodb.yml; to use a managed/external
# MongoDB instead, drop compose.mongodb.yml from the compose file chain
# and set host/port (+ credentials above) here. The external server MUST
# be a replica set (decision 81: the module uses multi-document
# transactions) — Atlas and managed offerings always are.
# MONGO_DB_HOST=mongo
# MONGO_DB_PORT=27017

# NOTE there is deliberately NO LANGWATCH_API_KEY here (decision 127): the
# key is the AGENTS' credential for SENDING traces in — no container of
# this component reads it. It lives in LangWatch's own Postgres; agents
# receive it via the platform vault (copy it from the LangWatch UI when
# seeding), and the demo push fetches it from Postgres at push time.

# LangWatch project id (e.g. project_abc123..., visible in the LangWatch
# UI URL) — written by scripts/3-onboard-langwatch.sh. This is BOTH the
# row filter of the direct-ClickHouse sync AND the gate that enables
# ingestion (decision 127): while empty, the trace-ingestion-worker idles
# and `make sync` refuses to run.
LANGWATCH_PROJECT_ID=

# EXPLICIT fixture opt-in (decision 127) — offline demos ONLY. With
# TRACE_SOURCE=fixtures, `make sync` reads the generated demo fixtures
# instead of a real source. A real client NEVER sets this: without a
# configured source the sync crashes loudly instead of silently
# "ingesting" fixture data into the permanent archive.
# TRACE_SOURCE=fixtures

# Sync-worker knobs (all optional — defaults shown). Demo values trade the
# safety margins for immediacy (e.g. 5/100/5/60); production keeps the
# defaults — only the quiet period changes WHAT gets permanently recorded.
# Seconds between "anything new?" polls of the source once caught up.
# TRACE_INGESTION_INTERVAL_SECONDS=60
# Max traces fetched/processed per sync tick — the worker's memory/work bound.
# TRACE_INGESTION_BATCH_SIZE=1000
# Seconds a trace must stay UNCHANGED before ingestion (decision 61): ingest
# mid-run = partial spans/tokens priced forever (the stamp is immutable).
# TRACE_INGESTION_QUIET_PERIOD_SECONDS=900
# Backstop cadence for re-stamping pending_price traces — price registration
# (POST /prices, make price) already reprocesses immediately (decision 57).
# REPROCESS_INTERVAL_SECONDS=3600

# LangWatch horizontal scaling (decision 78). The scaling unit is
# langwatch-workers (stateless queue consumers over the single
# postgres/redis/clickhouse spine). The app and the trace-ingestion-worker
# stay at 1 replica by design — see compose.connector.yml. When raising
# replicas, raise the store limits too: N workers multiply load on the
# same three stores (each workers replica is also capped at
# LANGWATCH_WORKERS_MEMORY_LIMIT, so budget host RAM accordingly).
# LANGWATCH_WORKERS_REPLICAS=1
# LANGWATCH_MEMORY_LIMIT=2g
# LANGWATCH_WORKERS_MEMORY_LIMIT=1536m
# LW_POSTGRES_MEMORY_LIMIT=256m
# LW_REDIS_MEMORY_LIMIT=512m
# LW_CLICKHOUSE_MEMORY_LIMIT=2g
# LW_CLICKHOUSE_CPU_LIMIT=1.0

# Per-instance LangWatch secrets — generate each with `openssl rand -base64 32`.
# REQUIRED: compose refuses to start (or stop) the connector role while any
# of the three is empty — LangWatch itself skips env validation and would
# boot with forgeable empty secrets, and with >1 workers replica the
# replicas must share identical secrets to validate each other's sessions.
# CREDENTIALS_SECRET must NEVER change after first boot (stored credentials
# become undecryptable).
LW_NEXTAUTH_SECRET=
LW_API_TOKEN_JWT_SECRET=
LW_CREDENTIALS_SECRET=

# Image references. The module image serves the API; the connector image
# runs the trace-ingestion-worker sidecar AND the manual `make sync` job.
# Production deployments pin registry tags (e.g.
# registry.example.com/platform-module:1.4.2); dev builds locally via
# compose.dev.yml and keeps the defaults.
MODULE_IMAGE=platform-module:local
CONNECTOR_IMAGE=platform-connector:local
# UI_IMAGE=platform-ui:local

# Dev-only (compose.dev.yml): publish mongo on this localhost port for
# Compass/mongosh. Leave unset in production env files.
# MONGO_HOST_PORT=27018
