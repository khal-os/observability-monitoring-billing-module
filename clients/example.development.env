# ============================================================================
# DEVELOPMENT ENV — the workstation/demo shape of one client deployment.
# Lean on purpose: only what a local stack needs. The FULL contract (every
# var, production stance, all optional blocks) is example.production.env.
#
# scripts/1-init-client-env.sh generates a file like this one (ports
# auto-allocated, secrets minted); copy this by hand only when you want to
# fill things yourself:
#
#   cp clients/example.development.env clients/<name>.env
#   docker compose -f compose.module.yml -f compose.connector.yml \
#     -f compose.mongodb.yml -f compose.dev.yml --env-file clients/<name>.env up -d
# ============================================================================

# Identity: compose project prefix and the client's database name — keep
# both equal to the client slug.
COMPOSE_PROJECT_NAME=example
CLIENT_NAME=example

# Decision 130 (REQUIRED): the client's business timezone (IANA) — billing
# boundary = display zone.
CLIENT_TIMEZONE=America/Sao_Paulo

# Host ports — unique per client on a shared workstation (the generator
# auto-allocates from these bases).
API_PORT=3001
LANGWATCH_PORT=5561
UI_PORT=8081

# REQUIRED (compose refuses empty): the browser-visible LangWatch URL.
# Locally that's just the published port.
LANGWATCH_PUBLIC_URL=http://localhost:5561

# Auth-less dev mongo: leave both empty (set them BEFORE first boot to
# enable auth — the volume keeps the first-boot user).
MONGO_DB_USER=
MONGO_DB_PASSWORD=

# Per-instance LangWatch secrets — REQUIRED even locally; generate each with
# `openssl rand -base64 32`. CREDENTIALS_SECRET must never change after
# first boot.
LW_NEXTAUTH_SECRET=
LW_API_TOKEN_JWT_SECRET=
LW_CREDENTIALS_SECRET=

# Locally-built images (`make images`); compose.dev.yml (re)builds them.
MODULE_IMAGE=platform-module:local
CONNECTOR_IMAGE=platform-connector:local

# Sync-worker DEMO knobs — fast feedback; production keeps the defaults
# (60/1000/900/3600 — see example.production.env, decision 61).
TRACE_INGESTION_INTERVAL_SECONDS=5
TRACE_INGESTION_BATCH_SIZE=100
TRACE_INGESTION_QUIET_PERIOD_SECONDS=5
REPROCESS_INTERVAL_SECONDS=60

# LangWatch project id — written by scripts/3-onboard-langwatch.sh; while
# empty, ingestion idles and `make sync` refuses to run (decision 127).
LANGWATCH_PROJECT_ID=

# Dev-only (compose.dev.yml): publish mongo on this localhost port for
# Compass/mongosh. Leave unset in production env files.
MONGO_HOST_PORT=27018

# Offline demo ONLY (decision 127): `make sync` reads generated fixtures
# instead of a real source. A real client NEVER sets this.
# TRACE_SOURCE=fixtures

# khal platform auth — usually OFF locally (API open, PoC behavior). To
# exercise the gate against a local khal stack, see the quartet in
# example.production.env (KHAL_DISCOVERY_URL=http://host.docker.internal:7103
# — resolved from inside the container, so never 127.0.0.1).
