{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "main": "main/index.js",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "ENVIRONMENT=development node dist/main/index.js",
    "deploy": "npm run build && npm run start",
    "start:dev": "ENVIRONMENT=development tsx watch src/main/index.ts",
    "migrate": "ENVIRONMENT=development tsx src/main/jobs/run-migrations.ts",
    "price:insert": "ENVIRONMENT=development tsx src/main/jobs/insert-price-version.ts",
    "sync": "ENVIRONMENT=development tsx src/main/jobs/run-sync.ts",
    "reprocess:pending": "ENVIRONMENT=development tsx src/main/jobs/reprocess-pending.ts",
    "test": "ENVIRONMENT=test jest --passWithNoTests --silent --noStackTrace --collectCoverage=false --runInBand",
    "test:verbose": "ENVIRONMENT=test jest --passWithNoTests",
    "test:unit": "npm test -- --watch --config=jest-unit.config.mjs",
    "test:integration": "npm test -- --watch --config=jest-integration.config.mjs",
    "test:ci": "npm test -- --collectCoverage=true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@shelf/jest-mongodb": "^6.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.1",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/jest": "^30.0.0",
    "@types/mongodb": "^4.0.6",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "git-commit-msg-linter": "^5.0.8",
    "jest": "^30.3.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.17.1",
    "fast-glob": "^3.3.3",
    "mongodb": "^7.2.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  }
}
