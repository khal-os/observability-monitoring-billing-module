# Single-tenant UI: serve the statics and proxy /api to THIS client's api
# service over the project network. Same origin — the UI needs no API
# address, no CORS, no discovery.
#
# This is an nginx-image envsubst TEMPLATE: ${CLIENT_NAME} is substituted at
# container start (only defined env vars are replaced — nginx runtime vars
# like $host survive). The image stays client-agnostic; identity arrives
# via the stack's env.
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        # Resolve `api` per-request via Docker's embedded DNS instead of
        # once at nginx startup: onboarding recreates the api container
        # AFTER the ui is up, and a startup-time resolution would keep
        # proxying to the old IP forever (/api hangs while / still works).
        # proxy_pass through a variable forces re-resolution.
        resolver 127.0.0.11 valid=10s;
        set $api_upstream http://api:3000;
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Deployment identity for the header — the only place the UI learns
    # which client it belongs to.
    location = /client.json {
        default_type application/json;
        return 200 '{"client":"${CLIENT_NAME}","timezone":"${CLIENT_TIMEZONE}"}';
    }

    location / {
        # Always revalidate the static shell (cheap ETag 304s): without
        # this, heuristic caching keeps an open tab on a STALE app.js
        # after a ui image update — new behavior seems "not deployed".
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
