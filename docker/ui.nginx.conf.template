# Single-tenant UI: serve the statics and proxy /api to THIS client's api
# service over the project network. Same origin — the UI needs no API
# address, no CORS, no discovery.
#
# This is an nginx-image envsubst TEMPLATE: ${CLIENT_NAME} is substituted at
# container start (only defined env vars are replaced — nginx runtime vars
# like $host survive). The image stays client-agnostic; identity arrives
# via the stack's env.
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass http://api:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Deployment identity for the header — the only place the UI learns
    # which client it belongs to.
    location = /client.json {
        default_type application/json;
        return 200 '{"client":"${CLIENT_NAME}"}';
    }

    location / {
        try_files $uri /index.html;
    }
}
